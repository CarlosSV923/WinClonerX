  "cards": [
    {
      "dot": "violet",
      "title": "Real phases, in order",
      "items": [
        "Revalidate · ShrinkSource (optional) · Snapshot · PrepareTarget · CopyData · FullVerification (optional) · CommitLayout · ExpandFileSystem (when needed) · RepairBoot · StructuralVerification · Cleanup · RestoreSource (if shrunk)."
      ]
    },
    {
      "dot": "amber",
      "title": "Non-interruptible phases",
      "items": [
        "ShrinkSource, CommitLayout, RepairBoot, Cleanup and RestoreSource. A cancel requested during them waits until they finish."
      ]
    },
    {
      "dot": "cyan",
      "title": "Verification",
      "items": [
        "The full one re-reads the target and compares SHA-256 digests taken during the copy, before the GPT is written. The structural one checks the clone at the end."
      ]
    }
