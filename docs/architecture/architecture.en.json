  "cards": [
    {
      "dot": "rose",
      "title": "Write boundary",
      "items": [
        "DiskWriteGuard is the only path to open a physical disk for writing. It rejects both the system disk and the disk hosting running Windows."
      ]
    },
    {
      "dot": "cyan",
      "title": "Ports and adapters",
      "items": [
        "Application depends on ports; Infrastructure.Windows registers the Windows adapters."
      ]
    }
