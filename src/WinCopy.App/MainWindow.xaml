<Window x:Class="WinCopy.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WinCopy.App"
        xmlns:loc="clr-namespace:WinCopy.App.Localization"
        xmlns:controls="clr-namespace:WinCopy.App.Controls"
        xmlns:views="clr-namespace:WinCopy.App.Views"
        xmlns:vm="clr-namespace:WinCopy.App.ViewModels"
        xmlns:themes="clr-namespace:WinCopy.App.Themes"
        mc:Ignorable="d"
        Title="{loc:Loc App_Title}"
        Width="1000" Height="680"
        MinWidth="900" MinHeight="600"
        Background="{StaticResource Brush.Background}"
        FontFamily="{x:Static themes:WinCopyFonts.Text}">
    <Window.Resources>
        <!-- Each page is shown by the type of the current content (CurrentPage). -->
        <DataTemplate DataType="{x:Type vm:DisksStepViewModel}">
            <views:DisksStepView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReviewStepViewModel}">
            <views:ReviewStepView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ConfirmStepViewModel}">
            <views:ConfirmStepView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProgressStepViewModel}">
            <views:ProgressStepView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ResultStepViewModel}">
            <views:ResultStepView />
        </DataTemplate>
        <!-- Placeholder for steps whose page does not exist yet. -->
        <DataTemplate DataType="{x:Type vm:WizardStep}">
            <Border Style="{StaticResource Card}">
                <TextBlock Style="{StaticResource Text.Subtitle}"
                           Text="{Binding TitleKey, Converter={StaticResource LocKeyConverter}}" />
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Left rail: app title and the step list. -->
        <Border Grid.RowSpan="2" Background="{StaticResource Brush.Rail}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Style="{StaticResource Text.Title}"
                           Foreground="{StaticResource Brush.RailText}"
                           Margin="20,24,20,20"
                           Text="{loc:Loc App_Title}" />
                <controls:StepRail StepItems="{Binding StepItems}" Margin="12,0,12,12" />
            </DockPanel>
        </Border>

        <!-- Content area: an optional notice above the page of the current step (or its placeholder). -->
        <DockPanel Grid.Row="0" Grid.Column="1" Margin="24,24,24,12">
            <Border DockPanel.Dock="Top"
                    Margin="0,0,0,12"
                    Visibility="{Binding HasNotice, Converter={StaticResource BoolToVisibility}}">
                <!-- A warning by default; green when the notice reports a success, such as a restored source. -->
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Card}">
                        <Setter Property="BorderBrush" Value="{StaticResource Brush.Danger}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsNoticeSuccess}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource Brush.Success}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Style="{StaticResource Text.Body}" Text="{Binding Notice}" />
            </Border>
            <ContentControl Content="{Binding CurrentPage}" />
        </DockPanel>

        <!-- Bottom bar: Back and Next. -->
        <StackPanel Grid.Row="1" Grid.Column="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="24,0,24,20">
            <Button Style="{StaticResource Button.Secondary}"
                    MinWidth="120"
                    Margin="0,0,12,0"
                    Content="{loc:Loc Common_Back}"
                    AutomationProperties.Name="{loc:Loc Common_Back}"
                    Command="{Binding BackCommand}" />
            <!-- Hidden on steps 3 and 4: step 3 has its own "Clone now" button and step 4 advances by itself. -->
            <Button Style="{StaticResource Button.Primary}"
                    MinWidth="120"
                    Content="{loc:Loc Common_Next}"
                    AutomationProperties.Name="{loc:Loc Common_Next}"
                    Visibility="{Binding IsNextVisible, Converter={StaticResource BoolToVisibility}}"
                    Command="{Binding NextCommand}" />
        </StackPanel>
    </Grid>
</Window>
