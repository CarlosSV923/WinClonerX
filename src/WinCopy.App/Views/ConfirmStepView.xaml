<UserControl x:Class="WinCopy.App.Views.ConfirmStepView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="clr-namespace:WinCopy.App.Localization"
             xmlns:vm="clr-namespace:WinCopy.App.ViewModels"
             xmlns:controls="clr-namespace:WinCopy.App.Controls"
             mc:Ignorable="d"
             d:DesignHeight="560" d:DesignWidth="760">
    <UserControl.Resources>
        <Style x:Key="ConfirmStep.Heading" TargetType="TextBlock" BasedOn="{StaticResource Text.Subtitle}">
            <Setter Property="Margin" Value="0,20,0,8" />
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Style="{StaticResource Text.Title}" Text="{loc:Loc Confirm_Title}" />
            <TextBlock Style="{StaticResource Text.Body}"
                       Margin="0,6,0,0"
                       Foreground="{StaticResource Brush.TextSecondary}"
                       Text="{loc:Loc Confirm_Subtitle}" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Margin="0,8,0,0">
            <StackPanel>
                <!-- The disk that will be erased: model, full serial number, capacity and partitions, with the erase warning. -->
                <TextBlock Style="{StaticResource ConfirmStep.Heading}" Text="{loc:Loc Confirm_Target_Heading}" />
                <Border Style="{StaticResource Card}" BorderBrush="{StaticResource Brush.Danger}" BorderThickness="2">
                    <StackPanel>
                        <controls:DiskCard DataContext="{Binding TargetCard}" />
                        <TextBlock Style="{StaticResource Text.Subtitle}"
                                   Margin="0,12,0,0"
                                   Foreground="{StaticResource Brush.Danger}"
                                   Text="{loc:Loc Confirm_Erase_Warning}" />
                    </StackPanel>
                </Border>

                <!-- Shrink of the source (FR-013), only when the plan needs it. Its own checkbox, apart from the serial confirmation. -->
                <Border Style="{StaticResource Card}"
                        Margin="0,12,0,0"
                        BorderBrush="{StaticResource Brush.Accent}"
                        BorderThickness="2"
                        Visibility="{Binding HasSourceShrink, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Subtitle}" Text="{loc:Loc Shrink_Heading}" />
                        <TextBlock Style="{StaticResource Text.Body}" Margin="0,6,0,0" Text="{Binding SourceShrinkText}" />
                        <CheckBox Margin="0,10,0,0"
                                  Content="{loc:Loc Shrink_Confirm_Understand}"
                                  AutomationProperties.Name="{loc:Loc Shrink_Confirm_Understand}"
                                  IsChecked="{Binding ConfirmSourceShrink}" />
                    </StackPanel>
                </Border>

                <!-- Verification: the characters are typed in the field. Enter in the field completes the step (default button). -->
                <TextBlock Style="{StaticResource ConfirmStep.Heading}" Text="{Binding PromptText}" />
                <TextBox x:Name="SuffixBox"
                         Width="240"
                         MinHeight="36"
                         Margin="0,4,0,0"
                         HorizontalAlignment="Left"
                         FontSize="16"
                         Text="{Binding TypedSuffix, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="{Binding PromptText}"
                         AutomationProperties.HelpText="{loc:Loc Confirm_Field_Help}" />
                <TextBlock Style="{StaticResource Text.Caption}"
                           Margin="0,6,0,0"
                           Text="{loc:Loc Confirm_Field_Help}" />

                <TextBlock Style="{StaticResource Text.Body}"
                           Margin="0,12,0,0"
                           Foreground="{StaticResource Brush.Danger}"
                           AutomationProperties.LiveSetting="Assertive"
                           AutomationProperties.Name="{Binding ErrorMessage}"
                           Text="{Binding ErrorMessage}"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}" />

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
