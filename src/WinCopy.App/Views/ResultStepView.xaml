<UserControl x:Class="WinCopy.App.Views.ResultStepView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="clr-namespace:WinCopy.App.Localization"
             mc:Ignorable="d"
             d:DesignHeight="560" d:DesignWidth="760">
    <UserControl.Resources>
        <Style x:Key="ResultStep.Heading" TargetType="TextBlock" BasedOn="{StaticResource Text.Subtitle}">
            <Setter Property="Margin" Value="0,20,0,8" />
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Style="{StaticResource Text.Title}" Text="{Binding Title}" />
            <TextBlock Style="{StaticResource Text.Body}"
                       Margin="0,6,0,0"
                       Foreground="{StaticResource Brush.TextSecondary}"
                       Text="{Binding Body}" />
            <TextBlock Style="{StaticResource Text.Caption}"
                       Margin="0,6,0,0"
                       Text="{Binding DurationLine}" />
        </StackPanel>

        <!-- TODO(US3): Export log opens the save dialog (FR-026). Shown disabled until then. -->
        <Button DockPanel.Dock="Bottom"
                Style="{StaticResource Button.Secondary}"
                HorizontalAlignment="Left"
                Margin="0,12,0,0"
                MinWidth="120"
                Content="{loc:Loc Result_ExportLog}"
                AutomationProperties.Name="{loc:Loc Result_ExportLog}"
                IsEnabled="{Binding IsExportLogAvailable}"
                ToolTip="{loc:Loc Common_ComingSoon}"
                ToolTipService.ShowOnDisabled="True" />

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Margin="0,8,0,0">
            <StackPanel>
                <!-- Success: the structural verification. -->
                <StackPanel Visibility="{Binding HasVerification, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource ResultStep.Heading}" Text="{loc:Loc Result_Verification_Heading}" />
                    <TextBlock Style="{StaticResource Text.Body}" Text="{Binding VerificationSummary}" />
                    <ItemsControl Margin="0,4,0,0" Focusable="False" ItemsSource="{Binding VerificationIssues}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource Text.Body}" Margin="0,2,0,0" Text="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Success: WinRE. A warning explains what to do; Windows still starts. -->
                <StackPanel Visibility="{Binding HasRecovery, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource ResultStep.Heading}" Text="{loc:Loc Result_Recovery_Heading}" />
                    <Border Style="{StaticResource Card}">
                        <TextBlock Style="{StaticResource Text.Body}" Text="{Binding RecoveryText}" />
                    </Border>
                </StackPanel>

                <!-- Failed or cancelled: why it stopped. -->
                <Border Style="{StaticResource Card}"
                        Margin="0,16,0,0"
                        Visibility="{Binding IsFailure, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource Text.Body}" Text="{Binding Reason}" />
                </Border>

                <!-- Next steps (success), or keeping the original disk (failed or cancelled). -->
                <TextBlock Style="{StaticResource ResultStep.Heading}" Text="{loc:Loc Result_NextSteps_Heading}" />
                <ItemsControl Focusable="False" ItemsSource="{Binding NextSteps}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Style="{StaticResource Text.Body}" Margin="0,4,0,0" Text="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- TODO(US3): the full failed and cancelled variants: state of the original and the destination disks. -->
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
