<UserControl x:Class="WinCopy.App.Controls.DiskCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:WinCopy.App.Controls"
             mc:Ignorable="d"
             AutomationProperties.Name="{Binding AutomationName}"
             AutomationProperties.HelpText="{Binding HelpText}"
             d:DesignWidth="520">
    <UserControl.Resources>
        <!-- Eligibility badge: green for eligible, red for not eligible. The text carries the meaning too. -->
        <Style x:Key="DiskCard.Badge" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Brush.Success}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Margin" Value="12,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEligible}" Value="False">
                    <Setter Property="Background" Value="{StaticResource Brush.Danger}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!-- The card's accessible name and help text come from the view model. Selection and disabled states are styled here. -->
    <Border Padding="14,12"
            AutomationProperties.Name="{Binding AutomationName}"
            AutomationProperties.HelpText="{Binding HelpText}">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
                <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Cursor" Value="Arrow" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSelectable}" Value="True">
                        <Setter Property="Cursor" Value="Hand" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                        <Setter Property="BorderThickness" Value="2" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                        <Setter Property="Background" Value="{StaticResource Brush.Background}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Style="{StaticResource Text.Subtitle}"
                           Text="{Binding Model}"
                           TextTrimming="CharacterEllipsis" />

                <Border Grid.Column="1"
                        Style="{StaticResource DiskCard.Badge}"
                        Visibility="{Binding StatusText, Converter={StaticResource NullToVisibility}}">
                    <TextBlock FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.RailText}"
                               Text="{Binding StatusText}" />
                </Border>
            </Grid>

            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,0" Text="{Binding SerialText}" />
            <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding CapacityText}" />
            <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding BusText}" />
            <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding GuidText}" />

            <controls:PartitionBar Margin="0,10,0,0"
                                   AutomationProperties.HelpText="{Binding PartitionBar.AccessibleText}"
                                   Partitions="{Binding PartitionBar.Segments}"
                                   DiskSize="{Binding PartitionBar.DiskSize}" />

            <ItemsControl Margin="0,8,0,0"
                          Focusable="False"
                          ItemsSource="{Binding Reasons}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Style="{StaticResource Text.Body}" Margin="0,2,0,0" Text="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Style="{StaticResource Text.Body}"
                       Margin="0,8,0,0"
                       FontWeight="SemiBold"
                       Text="{Binding StrategyText}"
                       Visibility="{Binding StrategyText, Converter={StaticResource NullToVisibility}}" />

            <TextBlock Style="{StaticResource Text.Body}"
                       Margin="0,4,0,0"
                       FontWeight="SemiBold"
                       Text="{Binding ShortfallText}"
                       Visibility="{Binding ShortfallText, Converter={StaticResource NullToVisibility}}" />
        </StackPanel>
    </Border>
</UserControl>
