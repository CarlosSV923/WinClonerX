<UserControl x:Class="WinClonerX.App.Controls.StepRail"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="clr-namespace:WinClonerX.App.Localization"
             xmlns:vm="clr-namespace:WinClonerX.App.ViewModels"
             xmlns:themes="clr-namespace:WinClonerX.App.Themes"
             mc:Ignorable="d"
             d:DesignHeight="520" d:DesignWidth="220">
    <UserControl.Resources>
        <!-- Step number, hidden once the step is completed. -->
        <Style x:Key="StepRail.Number" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{x:Static themes:WinClonerXFonts.Text}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Brush.RailText}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Check glyph (Segoe Fluent Icons), shown only once the step is completed. -->
        <Style x:Key="StepRail.Check" TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="FontFamily" Value="{x:Static themes:WinClonerXFonts.Icons}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource Brush.RailText}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ItemsControl ItemsSource="{Binding StepItems, RelativeSource={RelativeSource AncestorType=UserControl}}"
                  AutomationProperties.Name="{loc:Loc Rail_Steps_Label}"
                  Focusable="False">
        <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:WizardStepItemViewModel}">
                <Border x:Name="Item"
                        Margin="0,4"
                        Padding="12,10"
                        CornerRadius="8"
                        Background="Transparent">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Width="28"
                                Height="28"
                                CornerRadius="14"
                                Background="{StaticResource Brush.RailMuted}">
                            <Grid>
                                <TextBlock Style="{StaticResource StepRail.Number}"
                                           Text="{Binding Number}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource StepRail.Check}"
                                           Text="{loc:Loc Icon_Check}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <TextBlock Grid.Column="1"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   FontFamily="{x:Static themes:WinClonerXFonts.Text}"
                                   FontSize="14"
                                   Foreground="{StaticResource Brush.RailText}"
                                   TextWrapping="Wrap"
                                   Text="{Binding TitleKey, Converter={StaticResource LocKeyConverter}}" />
                    </Grid>
                </Border>

                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                        <Setter TargetName="Item" Property="Background" Value="{StaticResource Brush.Accent}" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
