<UserControl x:Class="WinClonerX.App.Views.ReviewStepView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="clr-namespace:WinClonerX.App.Localization"
             xmlns:vm="clr-namespace:WinClonerX.App.ViewModels"
             xmlns:controls="clr-namespace:WinClonerX.App.Controls"
             mc:Ignorable="d"
             d:DesignHeight="560" d:DesignWidth="760">
    <UserControl.Resources>
        <Style x:Key="ReviewStep.Heading" TargetType="TextBlock" BasedOn="{StaticResource Text.Subtitle}">
            <Setter Property="Margin" Value="0,20,0,8" />
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="StepHeading"
                       Style="{StaticResource Text.Title}"
                       Focusable="True"
                       AutomationProperties.Name="{loc:Loc Review_Title}"
                       Text="{loc:Loc Review_Title}" />
            <TextBlock Style="{StaticResource Text.Body}"
                       Margin="0,6,0,0"
                       Foreground="{StaticResource Brush.TextSecondary}"
                       Text="{loc:Loc Review_Subtitle}" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Margin="0,8,0,0">
            <StackPanel>
                <TextBlock Style="{StaticResource Text.Body}"
                           Margin="0,8,0,0"
                           AutomationProperties.LiveSetting="Polite"
                           AutomationProperties.Name="{loc:Loc Review_Loading}"
                           Text="{loc:Loc Review_Loading}"
                           Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />

                <!-- The plan could not be built: the reasons, and the way back. -->
                <Border Style="{StaticResource Card}"
                        Margin="0,8,0,0"
                        BorderBrush="{StaticResource Brush.Danger}"
                        AutomationProperties.Name="{loc:Loc Review_Failed_Title}"
                        Visibility="{Binding IsFailed, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Subtitle}"
                                   AutomationProperties.LiveSetting="Assertive"
                                   AutomationProperties.Name="{loc:Loc Review_Failed_Title}"
                                   Text="{loc:Loc Review_Failed_Title}" />
                        <TextBlock Style="{StaticResource Text.Body}" Margin="0,6,0,0" Text="{loc:Loc Review_Failed_Body}" />
                        <ItemsControl Margin="0,10,0,0"
                                      Focusable="False"
                                      ItemsSource="{Binding BlockingReasons}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource Text.Body}" Margin="0,4,0,0" Text="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- The plan: before and after on one scale, the size changes, the summary, the warnings and the verification option. -->
                <StackPanel Visibility="{Binding HasPlan, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource ReviewStep.Heading}" Text="{loc:Loc Review_Partitions_Heading}" />

                    <TextBlock Style="{StaticResource Text.Caption}" Text="{loc:Loc Review_Before}" />
                    <controls:PartitionBar Margin="0,4,0,0"
                                           AutomationProperties.HelpText="{Binding BeforeBar.AccessibleText}"
                                           Partitions="{Binding BeforeBar.Segments}"
                                           DiskSize="{Binding BeforeBar.DiskSize}" />

                    <TextBlock Style="{StaticResource Text.Caption}" Margin="0,12,0,0" Text="{loc:Loc Review_After}" />
                    <controls:PartitionBar Margin="0,4,0,0"
                                           AutomationProperties.HelpText="{Binding AfterBar.AccessibleText}"
                                           Partitions="{Binding AfterBar.Segments}"
                                           DiskSize="{Binding AfterBar.DiskSize}" />

                    <ItemsControl Margin="0,8,0,0"
                                  Focusable="False"
                                  ItemsSource="{Binding PartitionChanges}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource Text.Body}" Margin="0,2,0,0" Text="{Binding Text}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Temporary shrink of the source (FR-021): a clearly visible block, only when the plan needs it. -->
                    <Border Style="{StaticResource Card}"
                            Margin="0,12,0,0"
                            BorderBrush="{StaticResource Brush.Accent}"
                            BorderThickness="2"
                            Visibility="{Binding HasSourceShrink, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.Subtitle}" Text="{loc:Loc Shrink_Heading}" />
                            <TextBlock Style="{StaticResource Text.Body}" Margin="0,6,0,0" Text="{Binding SourceShrinkText}" />
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource ReviewStep.Heading}" Text="{loc:Loc Review_Summary_Heading}" />
                    <TextBlock Style="{StaticResource Text.Body}" Text="{Binding Summary.DataToCopy}" />
                    <TextBlock Style="{StaticResource Text.Body}" Margin="0,4,0,0" Text="{Binding Summary.EstimatedDuration}" />

                    <TextBlock Style="{StaticResource ReviewStep.Heading}"
                               Text="{loc:Loc Review_Warnings_Heading}"
                               Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVisibility}}" />
                    <ItemsControl Focusable="False" ItemsSource="{Binding Warnings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:WarningItemViewModel}">
                                <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Text.Body}" Text="{Binding Text}" />
                                        <!-- The checkbox is required before Next is enabled. -->
                                        <CheckBox Margin="0,8,0,0"
                                                  Content="{loc:Loc Review_Warning_Understand}"
                                                  AutomationProperties.Name="{loc:Loc Review_Warning_Understand}"
                                                  AutomationProperties.HelpText="{Binding Text}"
                                                  IsChecked="{Binding IsAccepted}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Full verification (FR-022a): off by default. Changing it rebuilds the plan, so the duration above follows it. -->
                    <CheckBox Margin="0,16,0,0"
                              Content="{loc:Loc Review_VerifyAll}"
                              AutomationProperties.Name="{loc:Loc Review_VerifyAll}"
                              IsChecked="{Binding VerifyAllData}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
