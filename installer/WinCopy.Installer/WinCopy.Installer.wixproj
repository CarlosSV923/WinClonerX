<Project Sdk="WixToolset.Sdk/6.0.2">
  <PropertyGroup>
    <OutputName>WinCopy</OutputName>
    <Platform>x64</Platform>
    <InstallerPlatform>x64</InstallerPlatform>
    <!-- MSI product version (major.minor.patch). Override from the command line: -p:WinCopyVersion=0.2.0 -->
    <WinCopyVersion Condition="'$(WinCopyVersion)' == ''">0.1.0</WinCopyVersion>
    <!-- Folder that receives the self-contained WinCopy.App publish. Lives under obj so it is never committed. -->
    <WinCopyAppProject>$(MSBuildThisFileDirectory)..\..\src\WinCopy.App\WinCopy.App.csproj</WinCopyAppProject>
    <WinCopyPublishDir>$(MSBuildProjectDirectory)\$(BaseIntermediateOutputPath)publish</WinCopyPublishDir>
    <DefineConstants>WinCopyVersion=$(WinCopyVersion);WinCopyPublishDir=$(WinCopyPublishDir)</DefineConstants>
  </PropertyGroup>

  <!-- Release builds run ICE validation (some ICEs may need an elevated process, WIX1105). Debug builds skip it
       so the solution stays green locally; the CI step builds Release. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <SuppressValidation>true</SuppressValidation>
  </PropertyGroup>

  <!-- Publishes WinCopy.App before the MSI is compiled. Always Release, self-contained, win-x64, and plain files
       (no single-file, no ReadyToRun), so the Files element can copy the whole folder.
       Why dotnet publish instead of a ProjectReference with Publish="true": WixToolset.Sdk 6.0.2 has no .NET
       publish integration; its ProjectReference handling only covers .wixlib and .vcxproj projects.
       dotnet publish also performs the win-x64 restore itself. -->
  <Target Name="WinCopyPublishApp" BeforeTargets="BeforeBuild">
    <Exec Command="dotnet publish &quot;$(WinCopyAppProject)&quot; -c Release -r win-x64 --self-contained true -p:PublishSingleFile=false -p:PublishReadyToRun=false -o &quot;$(WinCopyPublishDir)&quot; -nologo" />
  </Target>

</Project>
